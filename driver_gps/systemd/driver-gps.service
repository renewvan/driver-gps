[Unit]
Description=driver-gps MQTT driver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/driver-gps
ExecStart=/opt/driver-gps/.venv/bin/python -m driver_gps.main --config /opt/driver-gps/config.ini
Restart=on-failure
RestartSec=5
User=renewvan
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
